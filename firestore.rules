rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper: Check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper: Check if user document indicates admin or owner role
    function isAdmin() {
      return isSignedIn() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner');
    }
    
    // Helper: Check if user document indicates owner role specifically
    function isOwner() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 2. Merchants / Shops Collection
    match /merchants/{merchantId} {
      allow read: if true; // Anyone can browse stores
      allow write: if isAdmin(); // Only admins can add/edit stores
    }

    // 3. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Anyone can view reviews
      allow create: if isSignedIn(); // Logged-in users can write reviews
      allow update, delete: if isAdmin(); // Only admins can moderate reviews
    }

    // 4. Reports Collection
    match /reports/{reportId} {
      allow create: if isSignedIn(); // Logged-in users can submit reports
      allow read, update, delete: if isAdmin(); // Only admins can manage reports
    }

    // 5. Issues (Bug monitoring) Collection
    match /issues/{issueId} {
      allow create: if true; // Let app automatically upload crashes even if not authenticated
      allow read, update, delete: if isAdmin(); // Only admins can inspect/resolve bugs
    }

    // 6. Check-ins Collection
    match /checkins/{checkinId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 7. Newsletter Collection
    match /newsletter/{subId} {
      allow create: if true; // Anyone can subscribe
      allow read, update, delete: if isAdmin();
    }

    // 8. Announcements Collection
    match /announcements/{annId} {
      allow read: if true; // Anyone can read news
      allow write: if isAdmin();
    }

    // 9. Policies Collection
    match /policies/{policyId} {
      allow read: if true; // Anyone can read terms
      allow write: if isAdmin();
    }

    // 10. Policy History Collection
    match /policyHistory/{histId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Badges Collection
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Analytics Collection
    match /analytics/{analId} {
      allow read, write: if isAdmin();
    }

    // 13. Backups Collection
    match /backups/{backupId} {
      allow read, write: if isAdmin();
    }

    // 14. Settings Collection (Maintenance status)
    match /settings/{settingId} {
      allow read: if true; // Anyone can check maintenance mode or public settings
      allow write: if isAdmin(); // Only admins can change system settings
    }
  }
}
